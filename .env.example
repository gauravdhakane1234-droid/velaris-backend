# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/nexastudio

# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── OpenAI (optional — fallback mode works without it) ─
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Email (optional — Nodemailer via Gmail) ─────────────
# Enable 2FA on your Gmail then generate an App Password
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password
OWNER_EMAIL=you@gmail.com
